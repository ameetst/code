ation", "difference": "00:00:05", "dt": "25082023162607", "exchdisstime": "25-Aug-2023 16:26:12", "fileSize": "-", "hasXbrl": false, "old_new": null, "orgid": null, "seq_id": "105599734", "smIndustry": null, "sm_isin": "INE121N01019", "sm_name": "Thejo Engineering Limited", "sort_date": "2023-08-25 16:26:07", "symbol": "THEJO"}]