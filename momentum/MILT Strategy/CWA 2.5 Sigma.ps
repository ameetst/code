//@version=6
// ==========================================
// MILT Strategy (BB 30-week / 3.7-Sigma, 23-Week MA, ATR 14/1.8x)
// Pine Script implementation matching milt_strategy.py / backtest/milt_variant_backtest.py
// (backtested CAGR +31.97%, Sharpe 1.45 on BB_WINDOW=30 -- see
// MILT_Implementation_Summary.txt section 2 for the full parameter sweep).
//
// IMPORTANT: apply this indicator on a WEEKLY chart. MILT is explicitly a
// weekly-bar strategy (scan after Friday close, buy/sell at Monday's open)
// -- all periods below (30/23/14) are WEEKS, not days. Applying this to a
// daily or other intraday chart will NOT reproduce the backtested behaviour.
//
// Differs from the original "CWA 2.5-Sigma" indicator (preserved in
// "CWA 2.5 Sigma - original.txt") in every one of these ways:
//   - BB(30, 3.7 sigma) instead of BB(50, 2.5 sigma)
//   - No EMA trend filter gating entry (MILT has none; CWA required
//     close > EMA(100) to enter)
//   - Entry is a LEVEL check (close > bbUpper), not a crossover -- MILT
//     re-flags every week the close stays above the band, matching
//     milt_strategy.py's evaluate_entries()
//   - Exit trend-break uses a 23-week SMA, not an EMA
//   - ATR chandelier is RECOMPUTED fresh each week from the peak close
//     since entry and the CURRENT ATR (can loosen if ATR later expands) --
//     NOT a ratcheting running-max like the CWA version
// ==========================================

indicator("MILT Strategy (BB30 / 3.7-Sigma, 23W MA, ATR Chandelier)", overlay=true)

// ==========================================
// 1. INPUT PARAMETERS
// ==========================================
bbGroup   = "Bollinger Bands Settings"
bbPeriod  = input.int(30, title="BB Period (weeks)", minval=1, group=bbGroup)
bbSigma   = input.float(3.7, title="BB Standard Deviation (Sigma)", step=0.1, group=bbGroup)

trendGroup = "Trend Filter Settings"
maPeriod   = input.int(23, title="Trend SMA Period (weeks)", minval=1, group=trendGroup)

riskGroup  = "Volatility & Risk Settings"
atrPeriod  = input.int(14, title="ATR Period (weeks)", minval=1, group=riskGroup)
atrFactor  = input.float(1.8, title="ATR Trailing Factor", step=0.1, group=riskGroup)
maxSLPerc  = input.float(20.0, title="Maximum Stop Loss (%)", step=0.5, group=riskGroup)

// ==========================================
// 2. INDICATOR CALCULATIONS
// (chart must be Weekly -- see note above)
// ==========================================
trendSma = ta.sma(close, maPeriod)

bbBasis = ta.sma(close, bbPeriod)
bbDev   = bbSigma * ta.stdev(close, bbPeriod)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

atrVal = ta.atr(atrPeriod)   // Wilder-smoothed ATR (ta.atr uses ta.rma internally)

// ==========================================
// 3. LOGIC & SIGNALS
// ==========================================
var bool  inPosition  = false
var float entryPrice  = na
var float peakClose   = na   // highest weekly close since entry -- chandelier basis
var float hardMaxStop = na

// MILT entry: no trend filter -- pure Bollinger breakout, evaluated as a
// LEVEL check (not ta.crossover), so it keeps flagging while close stays
// above the band. Portfolio-level "not already held" is enforced by
// milt_strategy.py; on a single-symbol chart this indicator uses
// "not inPosition" as the closest equivalent.
bool bbBreakout   = close > bbUpper
bool buyCondition = bbBreakout and not inPosition

if buyCondition
    inPosition  := true
    entryPrice  := close
    peakClose   := close
    hardMaxStop := close * (1.0 - (maxSLPerc / 100.0))
else if inPosition
    peakClose := math.max(peakClose, close)

// Chandelier stop: recomputed fresh every bar from the peak close since
// entry and the CURRENT atrVal -- this can move DOWN (loosen) if atrVal
// later increases, unlike a ratcheting/monotonic chandelier.
float chandelierStop = peakClose - (atrFactor * atrVal)

bool hitHardStop  = inPosition and (close <= hardMaxStop)
bool hitTrendStop = inPosition and (close < trendSma)
bool hitAtrStop   = inPosition and (close < chandelierStop)

bool sellCondition = hitHardStop or hitTrendStop or hitAtrStop

string exitReasonText  = ""
float  tradeReturnPerc = na

if sellCondition
    // Priority matches milt_strategy.py's evaluate_exits(): hard stop first,
    // then trend reversal, then ATR chandelier.
    if hitHardStop
        exitReasonText := "STOP"
    else if hitTrendStop
        exitReasonText := "23W MA"
    else if hitAtrStop
        exitReasonText := "ATR"

    tradeReturnPerc := ((close - entryPrice) / entryPrice) * 100.0

    inPosition  := false
    entryPrice  := na
    peakClose   := na
    hardMaxStop := na

// ==========================================
// 4. CHART PLOTTING & VISUALS
// ==========================================
plot(trendSma, title="23W SMA", color=color.blue, linewidth=2)
plot(bbBasis, title="BB Basis (30W SMA)", color=color.gray, style=plot.style_line, linewidth=1)
pUpper = plot(bbUpper, title="BB Upper (3.7-Sigma)", color=color.green, linewidth=1)
pLower = plot(bbLower, title="BB Lower (3.7-Sigma)", color=color.red, linewidth=1)
fill(pUpper, pLower, color=color.new(color.purple, 95), title="BB Channel Background")

plot(inPosition ? chandelierStop : na, title="ATR Chandelier Stop", color=color.orange, style=plot.style_linebr, linewidth=2)

plotshape(buyCondition, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")

// Draw Dynamic Exit Labels with specific trade returns formatted to 1 decimal place
if sellCondition
    string prefixStr = tradeReturnPerc >= 0 ? "+" : ""
    string labelText = "EXIT (" + exitReasonText + ")\n" + prefixStr + str.tostring(tradeReturnPerc, "#.#") + "%"

    label.new(
       x=bar_index,
       y=high,
       text=labelText,
       style=label.style_label_down,
       color=tradeReturnPerc >= 0 ? color.teal : color.maroon,
       textcolor=color.white,
       size=size.small
     )
